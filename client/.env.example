# Copy to client/.env. Values here are exposed to the browser: never put secrets in them.
# Vite dev server proxies /api to http://localhost:5000.
VITE_API_BASE_URL=/api
# The dev proxy does not forward Socket.IO, so point it at the API server directly.
VITE_SOCKET_URL=http://localhost:5000
# MapTiler key for map tiles.
VITE_MAPTILER_KEY=
# true = run the UI on bundled mock stations without the API.
VITE_USE_MOCK_DATA=false
