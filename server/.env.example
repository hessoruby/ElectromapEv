# Copy to server/.env and fill in. Never commit the real file.
PORT=5000
# MongoDB Atlas or a replica set: station create/delete uses transactions.
MONGO_URI=mongodb://127.0.0.1:27017/electromap?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins in addition to localhost.
CLIENT_URL=http://localhost:5173
# Optional: avatar and station image uploads return 503 without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: lets IoT devices update charger status via the x-iot-token header.
IOT_SECRET_TOKEN=
